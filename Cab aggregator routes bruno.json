                "script": {
                  "req": "// Списки возможных значений\nconst colors = [\"red\", \"blue\", \"yellow\", \"green\", \"black\", \"white\"];\nconst brands = [\"tesla\", \"bmw\", \"audi\", \"mercedes\", \"toyota\", \"ford\"];\nconst letters = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\"; // Для генерации номера\n\n// Генерация случайного номера (формат: 1ABC234)\nfunction generateCarNumber() {\n    const digits = Math.floor(100 + Math.random() * 900); // 3 случайные цифры\n    const randomLetters = \n        letters.charAt(Math.floor(Math.random() * letters.length)) +\n        letters.charAt(Math.floor(Math.random() * letters.length)) +\n        letters.charAt(Math.floor(Math.random() * letters.length));\n    return `${digits}${randomLetters}`;\n}\n\nconst carData = {\n    color: colors[Math.floor(Math.random() * colors.length)],\n    car_brand: brands[Math.floor(Math.random() * brands.length)],\n    car_number: generateCarNumber()\n};\n\nreq.setBody(carData)",
