        {
          "type": "http",
          "name": "Sign Up",
          "filename": "Sign Up.bru",
          "seq": 1,
          "request": {
            "url": "{{baseAuthServiceUrl}}/api/v1/auth/signup",
            "method": "POST",
            "headers": [],
            "params": [],
            "body": {
              "mode": "json",
              "json": "{\n//     \"first_name\": \"Vlad\",\n//     \"last_name\": \"Kuzhyr\",\n//     \"password\": \"P@ssw0rd\",\n//     \"email\": \"vkuzir7@gmail.com\",\n//     \"phone\": \"+375298805187\",\n    \"business_role\":\"DRIVER\"\n}",
              "formUrlEncoded": [],
              "multipartForm": [],
              "file": []
            },
            "script": {
              "req": "// Списки возможных значений\nconst firstNames = [\"John\", \"Michael\", \"David\", \"James\", \"Robert\"];\nconst lastNames = [\"Doe\", \"Smith\", \"Johnson\", \"Williams\", \"Brown\"];\nconst domains = [\"gmail.com\", \"yahoo.com\", \"outlook.com\", \"proton.me\"];\n\n// Генерация случайного email\nfunction generateEmail(firstName, lastName) {\n    const randomNum = Math.floor(Math.random() * 100);\n    const domain = domains[Math.floor(Math.random() * domains.length)];\n    return `${firstName.toLowerCase()}${lastName.toLowerCase()}${randomNum}@${domain}`;\n}\n\n// Генерация случайного телефона (формат: +37529XXXXXXX)\nfunction generatePhone() {\n    return `+37529${Math.floor(1000000 + Math.random() * 9000000)}`;\n}\n\nvar randomFirstName = firstNames[Math.floor(Math.random() * firstNames.length)]\nvar randomLastName = lastNames[Math.floor(Math.random() * lastNames.length)]\n\n// Создаем объект со случайными данными DRIVER\nconst driverData = {\n    first_name: randomFirstName,\n    last_name: randomLastName,\n    password: \"P@ssw0rd\",\n    email: generateEmail(randomFirstName, randomLastName),\n    phone: generatePhone(),\n    business_role: req.body.business_role\n};\n\nbru.setEnvVar(\"driverEmail\", driverData.email)\nbru.setEnvVar(\"driverPassword\", driverData.password)\n\nreq.setBody(driverData)\n"
            },
            "vars": {},
            "assertions": [],
            "tests": "",
            "docs": "",
            "auth": {
              "mode": "none"
            }
